#!/bin/bash
#
# Сторож стенда обхода DPI. Раз в StartInterval проверяет два узла, без которых
# браузер не открывает вообще ничего, и чинит тот, что отвалился. Запускается под
# root из /Library/LaunchDaemons/local.zapret-watchdog.plist, sudo ему не нужен.
#
# Узел «zapret»: в com.darkware.zapret стоит только RunAtLoad, так что упавший tpws
# никто не поднимает, а правило PF продолжает заворачивать весь 80/443 на мёртвый
# порт — браузер получает ERR_CONNECTION_REFUSED на каждый сайт, включая
# незаблокированные. Ровно это и случилось 04.09.2026. Тем же способом ловится
# второй сбой, которого KeepAlive на процессе не увидел бы: вычищенный якорь PF
# (любой системный `pfctl -f /etc/pf.conf` сносит пользовательские якоря).
#
# Узел «dns»: системный резолвер настроен на 127.0.0.1, и залипший dnscrypt-proxy
# оставляет машину без DNS целиком — 10.09.2026 он держал сокет открытым, но не
# отвечал ни по UDP, ни по TCP, и не резолвился ни один домен.
#
# Порт tpws не зашит: он читается из загруженного якоря, поэтому смена TPPORT в
# config_custom сторожа не ломает.
set -uo pipefail

ZAPRET_CTL=/opt/darkware-zapret/init.d/macos/zapret
PF_ANCHOR=/etc/pf.anchors/zapret-v4
DNSCRYPT_LABEL=homebrew.mxcl.dnscrypt-proxy
DNS_PROBE_HOST=example.com
LOG=/var/log/zapret-watchdog.log
STATE_DIR=/var/run
BACKOFF=300

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$LOG"; }

pf_enabled() { pfctl -s info 2>/dev/null | grep -q '^Status: Enabled'; }

# Загружен ли якорь в работающий набор правил. Отдельная проверка от той, что ниже:
# системный `pfctl -f /etc/pf.conf` вычищает пользовательские якоря, оставляя tpws живым.
rdr_loaded() { pfctl -a zapret-v4 -s nat 2>/dev/null | grep -q 'rdr'; }

# Порт назначения берём из файла якоря, а не из вывода pfctl: файл пишет сам zapret,
# формат в нём предсказуем, а pfctl печатает правила нормализованными.
target_port() {
    sed -n 's/^rdr .*-> *127\.0\.0\.1 port \([0-9][0-9]*\).*/\1/p' "$PF_ANCHOR" 2>/dev/null | head -1
}

# Печатает, что именно сломалось; пустой вывод — всё в порядке.
diagnose_zapret() {
    pf_enabled || { echo "PF выключен"; return; }
    rdr_loaded || { echo "в загруженном якоре zapret-v4 нет rdr-правила"; return; }
    local port
    port="$(target_port)"
    [ -n "$port" ] || { echo "в $PF_ANCHOR не разобрать порт назначения"; return; }
    nc -z -G 1 127.0.0.1 "$port" >/dev/null 2>&1 ||
        echo "на порту $port никто не слушает — tpws не работает"
}

repair_zapret() { "$ZAPRET_CTL" restart >>"$LOG" 2>&1; }

# Без маршрута наружу резолвер не ответит и здоровым, так что в офлайне сторож молчит.
online() { route -n get default >/dev/null 2>&1; }

# Проверять открытый порт бессмысленно: залипший демон держит сокет и принимает
# соединения, не отвечая на них, — сбой виден только по настоящему запросу. Пустоту
# вывода на признак сбоя брать нельзя: свои communications error dig пишет в stdout,
# так что непустым он остаётся и при мёртвом резолвере, — отсюда проверка по коду
# возврата, а следом по самому адресу, отличающему ответ от SERVFAIL.
diagnose_dns() {
    online || return
    local answer
    if ! answer="$(dig +time=2 +tries=1 +short @127.0.0.1 "$DNS_PROBE_HOST" A 2>/dev/null)"; then
        echo "резолвер 127.0.0.1:53 не отвечает на запрос"
        return
    fi
    grep -qE '^[0-9]+(\.[0-9]+){3}$' <<<"$answer" ||
        echo "резолвер 127.0.0.1:53 не отдал адрес $DNS_PROBE_HOST"
}

# SIGTERM залипший процесс игнорирует: 10.09.2026 после kickstart он остался висеть,
# а поднятый следом инстанс намертво встал в bind() на занятом порту. Освободил порт
# только SIGKILL, а поднял демон заново KeepAlive из его plist.
repair_dns() {
    launchctl kickstart -k "system/$DNSCRYPT_LABEL" >>"$LOG" 2>&1
    sleep 5
    [ -z "$(diagnose_dns)" ] && return
    pkill -9 -f 'sbin/dnscrypt-proxy'
}

# У каждого узла своё состояние, иначе неподнимающийся сбой одного глушил бы попытки
# починить другой. Повторять починку каждые полминуты бессмысленно — от этого узел не
# поднимется, а лог станет нечитаемым; отсюда BACKOFF.
guard() {
    local name="$1" diagnose="$2" repair="$3"
    local state="$STATE_DIR/zapret-watchdog.$name.state"
    local fails=0 last=0 fault now

    if [ -f "$state" ]; then
        read -r fails last <"$state" 2>/dev/null || true
        case "$fails$last" in *[!0-9]* | "") fails=0; last=0 ;; esac
    fi

    fault="$($diagnose)"

    if [ -z "$fault" ]; then
        if [ "$fails" -gt 0 ]; then
            log "[$name] ОК: снова работает"
            rm -f "$state"
        fi
        return
    fi

    now="$(date +%s)"
    if [ "$fails" -gt 0 ] && [ "$((now - last))" -lt "$BACKOFF" ]; then
        return
    fi

    log "[$name] СБОЙ: $fault — чиню"
    $repair

    for _ in 1 2 3 4 5; do
        sleep 3
        fault="$($diagnose)"
        [ -z "$fault" ] && break
    done

    if [ -z "$fault" ]; then
        log "[$name] ОК: восстановлено"
        rm -f "$state"
    else
        fails=$((fails + 1))
        printf '%s %s\n' "$fails" "$now" >"$state"
        log "[$name] СБОЙ: починка не помогла ($fault); попытка $fails, следующая не раньше чем через $BACKOFF с"
    fi
}

guard zapret diagnose_zapret repair_zapret
guard dns diagnose_dns repair_dns
