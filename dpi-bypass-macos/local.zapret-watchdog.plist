<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.zapret-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/sbin/zapret-watchdog</string>
    </array>
    <key>StartInterval</key>
    <integer>30</integer>
    <!-- RunAtLoad выключен намеренно: при загрузке системы com.darkware.zapret
         поднимается параллельно, и сторож увидел бы ещё не занятый порт. Первый
         запуск через StartInterval даёт ему фору. -->
    <key>RunAtLoad</key>
    <false/>
    <key>StandardErrorPath</key>
    <string>/var/log/zapret-watchdog.log</string>
</dict>
</plist>
