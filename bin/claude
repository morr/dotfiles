#!/bin/bash
# Start every Claude Code session on opus.
#
# /model persists the choice into ~/.claude/settings.json (in the picker enter is
# "set as default"; `/model fable` with an argument persists unconditionally), so
# a switch to Fable leaks into every session started afterwards. A SessionStart
# hook cannot fix that: it runs after the session has already picked its model.
#
# --model is documented as "Model for the current session" and is never written
# back to settings, so forcing it here pins the default at launch without taking
# away the in-session /model switch.
#
# ~/dotfiles/bin comes before ~/.local/bin in PATH, so this also covers
# `with-proxy claude`, which execs claude by name.
#
# Left alone: an explicit --model of your own, and every subcommand (claude
# update, claude mcp, claude attach, …) — a subcommand after --model is not
# recognised as one at all, it is taken as the prompt of a fresh session, so a
# missing name here turns `claude attach <id>` into a chat about the word
# "attach". Keep the list in sync with `claude --help`.
#
# Everything goes through with-proxy, so a plain `claude` is already proxied and
# `with-proxy claude` stays harmless (the second pass just re-exports the same
# variables). with-proxy is called with the absolute path of the real binary —
# calling it with the name `claude` would resolve back to this binstub and loop.

real="$HOME/.local/bin/claude"
proxy="$HOME/dotfiles/bin/with-proxy5"

for arg in "$@"; do
  case "$arg" in
    --model | --model=*) exec "$proxy" "$real" "$@" ;;
  esac
done

case "${1:-}" in
  agents | attach | auth | auto-mode | config | doctor | gateway | import | install | kill | \
  logs | mcp | migrate-installer | plugin | plugins | project | remote-control | respawn | rm | \
  serve | setup-token | ssh | stop | ultrareview | update | upgrade)
    exec "$proxy" "$real" "$@"
    ;;
esac

exec "$proxy" "$real" --model opus "$@"
